// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. Akun & Bisnis (Identity & Multi-Tenancy)
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("kasir") // super_admin, owner, manajer_gudang, kasir, pemasok
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  authTokens      AuthToken[]
  businesses      Business[]
  businessMembers BusinessMember[]
  supplier        Supplier?
  createdOrders   Order[]          @relation("OrderCreatedBy")
  stockMovements  StockMovement[]  @relation("StockMovementCreatedBy")
  purchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  createdBatches  KitchenBatch[]   @relation("BatchCreatedBy")
  createdTransfers BranchTransfer[] @relation("TransferCreatedBy")

  @@map("users")
}

model AuthToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @db.Text
  expiresAt DateTime @map("expires_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model Business {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  category      String?
  description   String?  @db.Text
  address       String?  @db.Text
  phoneBusiness String?  @map("phone_business")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  owner             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  members           BusinessMember[]
  customers         Customer[]
  products          Product[]
  orders            Order[]
  ingredients       Ingredient[]
  businessSuppliers BusinessSupplier[]
  purchaseOrders    PurchaseOrder[]
  kitchenBatches    KitchenBatch[]
  branchTransfers   BranchTransfer[]

  @@index([userId])
  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  role       String // manajer_gudang, kasir
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// ==========================================
// 2. Pelanggan & Konsumen (Web CRM / POS)
// ==========================================

model Customer {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  phone      String?  @map("phone")
  name       String
  address    String?  @db.Text
  isBlocked  Boolean  @default(false) @map("is_blocked")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([businessId])
  @@map("customers")
}

// ==========================================
// 3. Penjualan & Kasir (Downstream Sales)
// ==========================================

model Product {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  isAvailable Boolean  @default(true) @map("is_available")

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  productIngredients ProductIngredient[]

  @@index([businessId])
  @@map("products")
}

model Order {
  id             String   @id @default(uuid())
  businessId     String   @map("business_id")
  customerId     String?  @map("customer_id")
  createdById    String?  @map("created_by_id")
  source         String   @default("kasir") // web, kasir
  orderType      String   @default("dine-in") @map("order_type") // dine-in, takeaway, delivery
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal? @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal? @default(0) @map("tax_amount") @db.Decimal(12, 2)
  paymentMethod  String?  @default("cash") @map("payment_method") // cash, qris, edc
  paidAmount     Decimal? @default(0) @map("paid_amount") @db.Decimal(12, 2)
  changeAmount   Decimal? @default(0) @map("change_amount") @db.Decimal(12, 2)
  status         String   @default("pending") // pending, paid, preparing, completed, cancelled
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([createdById])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==========================================
// 4. Gudang & Stok (Inventory & Recipe/BOM)
// ==========================================

model Ingredient {
  id                  String    @id @default(uuid())
  businessId          String    @map("business_id")
  preferredSupplierId String?   @map("preferred_supplier_id")
  name                String
  unit                String    // gram, ml, pcs, kg
  stock               Decimal   @default(0) @db.Decimal(12, 3)
  minStock            Decimal   @default(0) @map("min_stock") @db.Decimal(12, 3)
  category            String?
  locationRack        String?   @map("location_rack")
  expiryDate          DateTime? @map("expiry_date")

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  preferredSupplier  Supplier?           @relation("PreferredSupplierIngredients", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  productIngredients ProductIngredient[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  batchItems         KitchenBatchItem[]
  transferItems      BranchTransferItem[]

  @@index([businessId])
  @@index([preferredSupplierId])
  @@map("ingredients")
}

model ProductIngredient {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  ingredientId String  @map("ingredient_id")
  qtyPerUnit   Decimal @map("qty_per_unit") @db.Decimal(12, 3)

  // Relations
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model StockMovement {
  id           String   @id @default(uuid())
  ingredientId String   @map("ingredient_id")
  createdById  String?  @map("created_by_id")
  type         String   // in, out, adjust
  qty          Decimal  @db.Decimal(12, 3)
  referenceId  String?  @map("reference_id") // order_id / purchase_order_id
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([createdById])
  @@map("stock_movements")
}

// ==========================================
// 5. Pemasok & Restock (Upstream Procurement)
// ==========================================

model Supplier {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  name      String
  category  String?
  phone     String?
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessSuppliers    BusinessSupplier[]
  supplierItems        SupplierItem[]
  preferredIngredients Ingredient[]        @relation("PreferredSupplierIngredients")
  purchaseOrders       PurchaseOrder[]

  @@map("suppliers")
}

model BusinessSupplier {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  supplierId String   @map("supplier_id")
  status     String   @default("active") // active, inactive, pending

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([businessId, supplierId])
  @@index([supplierId])
  @@map("business_suppliers")
}

model SupplierItem {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  name        String
  unit        String
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  stockQty    Decimal? @default(0) @map("stock_qty") @db.Decimal(12, 3)

  // Relations
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([supplierId])
  @@map("supplier_items")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  supplierId   String    @map("supplier_id")
  createdById  String?   @map("created_by_id")
  status       String    @default("draft") // draft, sent, confirmed, shipped, received, cancelled
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  deliveryNote String?   @map("delivery_note")
  driverInfo   String?   @map("driver_info")
  qcStatus     String?   @default("pending") @map("qc_status") // pending, passed, partial, rejected
  qcNotes      String?   @map("qc_notes") @db.Text
  receivedAt   DateTime? @map("received_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  supplierItemId  String?  @map("supplier_item_id")
  ingredientId    String?  @map("ingredient_id")
  quantity        Decimal  @db.Decimal(12, 3)
  price           Decimal  @db.Decimal(12, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierItem  SupplierItem? @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  ingredient    Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([supplierItemId])
  @@index([ingredientId])
  @@map("purchase_order_items")
}

// ==========================================
// 6. Dapur & Produksi (Kitchen Work Orders)
// ==========================================

model KitchenBatch {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  createdById  String?   @map("created_by_id")
  batchNumber  String    @map("batch_number") // BATCH-20261119-01
  recipeName   String    @map("recipe_name")   // Cold Brew Extraction Concentrate (30L)
  station      String?   // Central Bar Extraction, Bakery Oven Station
  operator     String?   // Fahmi Nugraha (Barista Lead)
  plannedYield String?   @map("planned_yield") // 120 Porsi Cold Brew
  actualYield  String?   @map("actual_yield")
  progress     Int       @default(0)           // 0 - 100
  status       String    @default("in_progress") // in_progress, completed, cancelled
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  // Relations
  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     KitchenBatchItem[]

  @@index([businessId])
  @@index([createdById])
  @@map("kitchen_batches")
}

model KitchenBatchItem {
  id           String  @id @default(uuid())
  batchId      String  @map("batch_id")
  ingredientId String? @map("ingredient_id")
  name         String  // e.g. Biji Kopi Arabika Lintong
  quantity     Decimal @db.Decimal(12, 3)
  unit         String  // kg, liter, gram

  // Relations
  batch      KitchenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  ingredient Ingredient?  @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([ingredientId])
  @@map("kitchen_batch_items")
}

// ==========================================
// 7. Distribusi Cabang (Inter-Outlet Transfers)
// ==========================================

model BranchTransfer {
  id             String    @id @default(uuid())
  businessId     String    @map("business_id")
  createdById    String?   @map("created_by_id")
  transferNumber String    @map("transfer_number") // TRF-OUT-202611-01
  origin         String    // Central Kitchen Senopati (Hub)
  destination    String    // Cabang Kopi Kenangan SCBD Lot 8
  driver         String?   // Wahyu Hidayat (Motor Kurir Hub)
  vehicleInfo    String?   @map("vehicle_info")    // Gran Max Blind Van (B 9811 KLC)
  departureTime  String?   @map("departure_time")  // 10:30 WIB
  eta            String?                           // 11:00 WIB
  status         String    @default("shipping")    // preparing, shipping, received, cancelled
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  receivedAt     DateTime? @map("received_at")

  // Relations
  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     BranchTransferItem[]

  @@index([businessId])
  @@index([createdById])
  @@map("branch_transfers")
}

model BranchTransferItem {
  id           String  @id @default(uuid())
  transferId   String  @map("transfer_id")
  ingredientId String? @map("ingredient_id")
  name         String  // e.g. Cold Brew Concentrate
  quantity     Decimal @db.Decimal(12, 3)
  unit         String  // liter, pcs, kg

  // Relations
  transfer   BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([ingredientId])
  @@map("branch_transfer_items")
}

