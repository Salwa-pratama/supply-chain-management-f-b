// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. Akun & Bisnis (Identity & Multi-Tenancy)
// ==========================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("kasir") // super_admin, owner, manajer_gudang, kasir, pemasok
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  authTokens      AuthToken[]
  businesses      Business[]
  businessMembers BusinessMember[]
  supplier        Supplier?
  createdOrders   Order[]          @relation("OrderCreatedBy")
  stockMovements  StockMovement[]  @relation("StockMovementCreatedBy")
  purchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")

  @@map("users")
}

model AuthToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @db.Text
  expiresAt DateTime @map("expires_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model Business {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String
  category      String?
  description   String?  @db.Text
  address       String?  @db.Text
  phoneBusiness String?  @map("phone_business")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  owner             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  members           BusinessMember[]
  bot               Bot?
  customers         Customer[]
  products          Product[]
  orders            Order[]
  ingredients       Ingredient[]
  businessSuppliers BusinessSupplier[]
  purchaseOrders    PurchaseOrder[]

  @@index([userId])
  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  role       String // manajer_gudang, kasir
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

// ==========================================
// 2. Bot & Chat (Conversational Commerce)
// ==========================================

model Bot {
  id          String   @id @default(uuid())
  businessId  String   @unique @map("business_id")
  name        String
  waNumber    String?  @map("wa_number")
  waStatus    String?  @default("disconnected") @map("wa_status")
  agentPrompt String?  @map("agent_prompt") @db.Text
  agentApi    String?  @map("agent_api")
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@map("bots")
}

model Customer {
  id            String   @id @default(uuid())
  businessId    String   @map("business_id")
  waPhoneNumber String   @map("wa_phone_number")
  name          String
  address       String?  @db.Text
  isBlocked     Boolean  @default(false) @map("is_blocked")

  // Relations
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]
  orders       Order[]

  @@unique([businessId, waPhoneNumber])
  @@map("customers")
}

model ChatSession {
  id         String    @id @default(uuid())
  botId      String    @map("bot_id")
  customerId String    @map("customer_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  status     String    @default("active") // active, ended, transferred

  // Relations
  bot      Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  order    Order?

  @@index([botId])
  @@index([customerId])
  @@map("chat_sessions")
}

model Message {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  senderType String   @map("sender_type") // bot, customer, agent
  content    String   @db.Text
  metadata   Json?
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

// ==========================================
// 3. Penjualan & Kasir (Downstream Sales)
// ==========================================

model Product {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  isAvailable Boolean  @default(true) @map("is_available")

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  productIngredients ProductIngredient[]

  @@index([businessId])
  @@map("products")
}

model Order {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  customerId  String?  @map("customer_id")
  sessionId   String?  @unique @map("session_id")
  createdById String?  @map("created_by_id")
  source      String   @default("kasir") // whatsapp, kasir
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  status      String   @default("pending") // pending, paid, preparing, completed, cancelled
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  session    ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy  User?        @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([businessId])
  @@index([customerId])
  @@index([createdById])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==========================================
// 4. Gudang & Stok (Inventory & Recipe/BOM)
// ==========================================

model Ingredient {
  id                  String   @id @default(uuid())
  businessId          String   @map("business_id")
  preferredSupplierId String?  @map("preferred_supplier_id")
  name                String
  unit                String   // gram, ml, pcs, kg
  stock               Decimal  @default(0) @db.Decimal(12, 3)
  minStock            Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  category            String?

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  preferredSupplier  Supplier?           @relation("PreferredSupplierIngredients", fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  productIngredients ProductIngredient[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([businessId])
  @@index([preferredSupplierId])
  @@map("ingredients")
}

model ProductIngredient {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  ingredientId String  @map("ingredient_id")
  qtyPerUnit   Decimal @map("qty_per_unit") @db.Decimal(12, 3)

  // Relations
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model StockMovement {
  id           String   @id @default(uuid())
  ingredientId String   @map("ingredient_id")
  createdById  String?  @map("created_by_id")
  type         String   // in, out, adjust
  qty          Decimal  @db.Decimal(12, 3)
  referenceId  String?  @map("reference_id") // order_id / purchase_order_id
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([createdById])
  @@map("stock_movements")
}

// ==========================================
// 5. Pemasok & Restock (Upstream Procurement)
// ==========================================

model Supplier {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  name      String
  category  String?
  phone     String?
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessSuppliers    BusinessSupplier[]
  supplierItems        SupplierItem[]
  preferredIngredients Ingredient[]        @relation("PreferredSupplierIngredients")
  purchaseOrders       PurchaseOrder[]

  @@map("suppliers")
}

model BusinessSupplier {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  supplierId String   @map("supplier_id")
  status     String   @default("active") // active, inactive, pending

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([businessId, supplierId])
  @@index([supplierId])
  @@map("business_suppliers")
}

model SupplierItem {
  id          String   @id @default(uuid())
  supplierId  String   @map("supplier_id")
  name        String
  unit        String
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true) @map("is_available")
  stockQty    Decimal? @default(0) @map("stock_qty") @db.Decimal(12, 3)

  // Relations
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([supplierId])
  @@map("supplier_items")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  supplierId  String   @map("supplier_id")
  createdById String?  @map("created_by_id")
  status      String   @default("draft") // draft, sent, confirmed, shipped, received, cancelled
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([businessId])
  @@index([supplierId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String   @map("purchase_order_id")
  supplierItemId  String?  @map("supplier_item_id")
  ingredientId    String?  @map("ingredient_id")
  quantity        Decimal  @db.Decimal(12, 3)
  price           Decimal  @db.Decimal(12, 2)

  // Relations
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierItem  SupplierItem? @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  ingredient    Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([supplierItemId])
  @@index([ingredientId])
  @@map("purchase_order_items")
}
