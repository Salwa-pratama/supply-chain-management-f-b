# Application Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication Configuration
JWT_SECRET=scm_secret_jwt_key_development_only_1234567890
JWT_EXPIRES_IN=1d

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=scm_db
DB_USER=scm_user
DB_PASSWORD=scm_password
DB_ROOT_PASSWORD=rootpassword

# Prisma Connection URL
# Untuk development dan migration (memerlukan hak akses membuat shadow database), gunakan user root:
DATABASE_URL="mysql://root:rootpassword@mysql:3306/scm_db"

# Jika menjalankan Prisma/NestJS dari Host OS (di luar devcontainer), gunakan:
# DATABASE_URL="mysql://root:rootpassword@localhost:3306/scm_db"
